from box.all.win
  where client != "nacdc_us@icd_na"
  where endswith(lower(new_process_name), "powershell.exe")
    or endswith(lower(new_process_name), "powershell_ise.exe")
    or endswith(lower(new_process_name), "pwsh.exe")
  where weakhas(process_command_line, "hidden")
  where weakhas(process_command_line, "-w")
    or weakhas(process_command_line, "WindowStyle=")
    or weakhas(process_command_line, "-windowstyle")
  where not (toktains(parent_process_name, "C:\\Windows\\ccmcache\\")
    or toktains(process_command_line, "C:\\ProgramData\\Amazon\\EC2-Windows\\Launch\\Module\\Ec2Launch.psd1")
    or toktains(process_command_line, "C:\\WINDOWS\\ccmcache\\")
    or toktains(process_command_line, "\\Quest\\DUA\\SignOutOfWAMAccounts.ps1")
    or endswith(parent_process_name, "\\vmtoolsd.exe")
    or weakhas(process_command_line, ".\\ack.ps1")
    or (endswith(parent_process_name, "Tools\\StdUtils\\TaniumExecWrapper.exe") and weakhas(process_command_line, "-Command Write-Output 'Success'"))
    or weaktoktains(process_command_line, "execute_scan.ps1")
    or weaktoktains(process_command_line, "mode con lines=1 cols=32766; Set-Variable -Name 'SNC_isWmi'")
    or parent_process_name = "C:\\Program Files\\RocketAgent\\rocketagent-x64.exe"
    or weaktoktains(process_command_line, "C:\\Scripts\\inactive_accounts.ps1"))
select machine as entity_sourceHostname, machineIp as entity_sourceIP, subjectDomain as entity_sourceDomain, subjectUsername as entity_sourceAccount, new_process_name as childProcess, parent_process_name as parentProcess, process_command_line as commandLine,  rawMessage as baseEvent, "{\"description\": \"Detects instances where PowerShell or Command Prompt processes are initiated with command-line parameters designed to create a hidden window. This tactic is often used by threat actors to execute scripts or commands stealthily, avoiding detection by users or administrators. The rule specifically targets process creation events where the executable image ends with common PowerShell or Command Prompt binaries such as cmd.exe, powershell.exe, powershell_ise.exe, and pwsh.exe. It focuses on identifying command-line arguments that include the term \\\"hidden,\\\" which is indicative of an attempt to suppress the application window from appearing on the desktop. The detection mechanism hones in on specific command-line parameters that further define window visibility settings, such as '-w', '-windowstyle', or 'WindowStyle='. These parameters are crucial for executing PowerShell commands without displaying any visible interface, a common technique in both legitimate administrative tasks and malicious activities. However, the rule excludes certain parent image paths and specific command-line paths associated with known legitimate software processes, such as those from Amazon EC2 Windows Launch scripts or certain Windows management frameworks, to reduce false positives. This exclusion helps focus the detection on unusual and potentially unauthorized hidden window executions that could be related to malicious activities like executing remote payloads, bypassing user consent protocols, or initiating background processes without alerting the logged-in user.\", \"investigation\": \"Investigate host for signs of compromise. What was the command hidden from the user? Review the full command line used in the process creation event to understand the specific actions attempted. Check for any network connections initiated by the process shortly before or after its creation. Examine file system modifications made by the PowerShell or Command Prompt process. Search for any related or subsequent process creations that appear unusual or suspicious. Analyze the parent process details to verify if it is expected behavior or indicative of process hollowing or spoofing. Look for any scheduled tasks or registry modifications that could be used for persistence. Investigate any associated user accounts to determine if they have been compromised or used anomalously. Correlate the alert with other security alerts or logs around the same timeframe to identify broader attack patterns.\", \"mitre_attack\": {\"platform\": \"windows\", \"tactic\": [\"Defense Evasion\", \"Execution\"], \"tactic_id\": [\"TA0005\", \"TA0002\"], \"technique\": [\"Hide Artifacts\", \"Command and Scripting Interpreter\"], \"technique_id\": [\"T1564\", \"T1059\"], \"sub_technique\": [\"Hidden Window\", \"PowerShell\"], \"sub_technique_id\": [\"T1564.003\", \"T1059.001\"]}, \"references\": [\"https://git.icd.capgemini.com/signatures/global-icd-detection-library/-/blob/main/active/endpoint/process_creation/powershell_creating_hidden_window\",\"https://attack.mitre.org/techniques/T1564/003/\"], \"ckc\": \"KC7-Actions on Objective\"}" as meta, "SecOpsPowershellHiddenWindow" as AlertName, `lu/SecOpsAlertDescription/alertType`(AlertName) as alertType, `lu/SecOpsAlertDescription/alertMitreTactics`(AlertName) as alertMitreTactics, `lu/SecOpsAlertDescription/alertMitreTechniques`(AlertName) as alertMitreTechniques, `lu/SecOpsAlertDescription/alertPriority`(AlertName) as alertPriority, "060fb27c-7642-4a4a-b5bf-d07ecf0918ae" as detection_id

