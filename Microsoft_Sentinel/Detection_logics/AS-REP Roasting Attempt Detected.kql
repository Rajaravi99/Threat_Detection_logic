SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID == 4768
| where AccountType == "User"
| where Status == "0x0"
| extend PreAuthType = coalesce(tostring(column_ifexists("PreAuthType", "")),extract(@"Name=['""]PreAuthType['""]>([^<]*)",1,tostring(column_ifexists("EventData", ""))))
| where PreAuthType in ("0", "0x0", "-")
| where TargetUserName !endswith "$"
| where TargetUserName !in~ ("krbtgt")
| extend TicketEncryptionType = extract(@"TicketEncryptionType"">([^<]+)", 1, EventData)
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    RequestCount = count(),
    SourceIPs = make_set(IpAddress, 50),
    Computers = make_set(Computer, 20),
    TicketEncryptionTypes = make_set(TicketEncryptionType, 10)
    by TargetUserName, Account, bin(TimeGenerated, 1h)
| where RequestCount >= 1
| project
    StartTime,
    EndTime,
    TargetUserName,
    Account,
    RequestCount,
    SourceIPs,
    Computers,
    TicketEncryptionTypes