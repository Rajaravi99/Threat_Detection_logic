let MDEAlerts = () {
    SecurityAlertMDE_CL
    | extend AlertId = tostring(SystemAlertId),
        OriginalAlertId = tostring(VendorOriginalId),
        AlertTitle = coalesce(tostring(AlertName), tostring(DisplayName)),
        SeverityNormalized = tolower(tostring(AlertSeverity)),
        StatusNormalized = tolower(tostring(Status)),
        EntitiesJson = parse_json(Entities),
        ExtendedPropertiesJson = parse_json(ExtendedProperties),
        MitreTactics = tostring(Tactics),
        MitreTechniques = tostring(Techniques)
};
MDEAlerts
| where TimeGenerated >= ago(10d)
| where SeverityNormalized in ("medium", "high")
| where StatusNormalized !in ("resolved", "dismissed", "closed")
| where isnotempty(EntitiesJson)
| extend TacticArray = split(MitreTactics, ",")
| mv-expand TacticArray
| extend Tactic = trim(@" ", tostring(TacticArray))
| summarize
    AlertCount = dcount(AlertId),
    DistinctTacticCount = dcountif(Tactic, isnotempty(Tactic)),
    HighSeverityAlertCount =
        dcountif(AlertId, SeverityNormalized == "high"),
    Alerts = make_set(AlertTitle, 20),
    AlertIds = make_set(AlertId, 20),
    Tactics = make_set_if(Tactic, isnotempty(Tactic), 20),
    Techniques = make_set(MitreTechniques, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by tostring(EntitiesJson)
| where AlertCount >= 3
| where DistinctTacticCount >= 2 or HighSeverityAlertCount >= 2
| extend
    DetectionReason = strcat(
        AlertCount,
        " distinct MDE alerts and ",
        DistinctTacticCount,
        " MITRE tactics were observed against the same entity."
    )
| project
    LastSeen,
    FirstSeen,
    AlertCount,
    HighSeverityAlertCount,
    DistinctTacticCount,
    Alerts,
    AlertIds,
    Tactics,
    Techniques,
    DetectionReason